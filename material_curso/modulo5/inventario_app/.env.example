# ------------------------------------------------------------
# Plantilla de variables de entorno
# Copie este archivo como .env y reemplace los valores.
# El archivo .env NUNCA debe subirse al repositorio.
# Lo leen tanto la aplicación Python como docker-compose.yml.
# ------------------------------------------------------------

# Servidor MySQL / MariaDB
# Con Docker use 127.0.0.1. Si ya tiene otro MySQL ocupando el
# puerto 3306 en su equipo, cambie DB_PORT (por ejemplo, a 3307).
DB_HOST=127.0.0.1
DB_PORT=3306

# Credenciales de la aplicación (use un usuario dedicado, no root)
DB_USER=app_inventario
DB_PASSWORD=cambia_esta_contrasena

# Base de datos definida en database/mysql_DDL.sql
DB_NAME=curso_python_db

# Conexiones que la aplicación mantiene abiertas y reutiliza (opcional, 1 a 32)
DB_POOL_SIZE=5

# Contraseña de root; solo la usa Docker al crear el contenedor
DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# Aplicación (opcionales)
APP_NAME=Sistema de Gestión de Inventario
APP_THEME=dark
